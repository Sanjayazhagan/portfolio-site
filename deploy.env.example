# Copy this file to `deploy.env` and fill in real values.
#
# deploy.ps1 uploads `deploy.env` to the VM and merges each KEY=value line
# ADDITIVELY into <VmPath>/.env.production.local — existing variables on the
# VM (DATABASE_URL, NEXTAUTH_*, etc.) are preserved; only the keys listed here
# are added or updated. The Next.js standalone server loads that file at boot.
#
# `deploy.env` is gitignored. Never commit real secrets.

# Server-side key for the AI resume generator (OpenRouter).
OPENROUTER_API_KEY=
